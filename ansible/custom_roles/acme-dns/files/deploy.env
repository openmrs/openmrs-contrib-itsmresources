# Consumed by /usr/local/bin/deploy-compose. acme-dns keeps its state (the sqlite
# accounts DB) in a host bind-mount, so the container must never be torn down with its
# volumes. HEALTH_CHECK_ENABLED is off because the container declares no compose
# healthcheck (deploy-compose would otherwise inspect-loop and no-op).
DESTROY_VOLUMES=false
HEALTH_CHECK_ENABLED=false
