# GENERATED from cloudflare_ip_ranges (group_vars/cloudflare/vars) -- edit there, not here.
#
# Cloudflare origin-pull real-IP recovery: restores the true visitor IP into $remote_addr.
# CF-Connecting-IP is trusted only from these ranges, so a client hitting the origin directly
# cannot spoof it.
{% for cidr in cloudflare_ip_ranges %}
set_real_ip_from {{ cidr }};
{% endfor %}
real_ip_header CF-Connecting-IP;
