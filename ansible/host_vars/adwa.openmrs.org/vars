---
# Docker host for chartsearchai with GPU
users:
  dkayiwa:
    comment: Daniel Kayiwa
    groups: 'admin'
    ssh_key: "ssh-rsa  danielkayiwa@Daniel-Kayiwas-MacBook-Pro.local"

datadog_tags_extra:
  - "service:openmrs-chartsearchai"

docker_deployment:
  - emr-3-ai

letsencrypt_cert_domains:
  - adwa.openmrs.org
  - chartsearchai.openmrs.org

nginx_keepalive_timeout: "600"
nginx_keepalive_requests: "600"

nginx_vhosts:
  - listen: "80"
    server_name: "adwa.openmrs.org"
    filename: "adwa.openmrs.org.80.conf"
    extra_parameters: |
      return 301 https://$host$request_uri;
  - listen: "443 ssl"
    server_name: "adwa.openmrs.org"
    filenaem: "adwa.openmrs.org.conf"
    extra_parameters: |
     access_log /var/log/nginx/deployer_access.log;
     error_log /var/log/nginx/deployer_error.log;
     ssl_certificate /etc/letsencrypt/live/adwa.openmrs.org/fullchain.pem;
     ssl_certificate_key /etc/letsencrypt/live/adwa.openmrs.org/privkey.pem;
     location ^~ /.well-known/acme-challenge/ {
       root /usr/share/nginx/html;
     }
  - listen: "80"
    server_name: "chartsearchai.openmrs.org"
    filename: "chartsearchai.openmrs.org.80.conf"
    extra_parameters: |
      return 301 https://$host$request_uri;
  - listen: "443 ssl"
    server_name: "chartsearchai.openmrs.org"
    extra_parameters: |
      access_log /var/log/nginx/chartsearchai_access.log;
      error_log /var/log/nginx/chartsearchai_error.log;
      ssl_certificate /etc/letsencrypt/live/adwa.openmrs.org/fullchain.pem;
      ssl_certificate_key /etc/letsencrypt/live/adwa.openmrs.org/privkey.pem;
      location ^~ /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
      }
      location / {
        return 301 https://chartsearchai.openmrs.org/openmrs/spa;
      }
      location /openmrs {
        proxy_set_header HOST $host;
        proxy_set_header  X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8888/openmrs;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
      }
