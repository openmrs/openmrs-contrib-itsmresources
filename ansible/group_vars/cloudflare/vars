---
# Hosts that proxy one or more vhosts through Cloudflare (orange cloud).
#
# Membership in `cloudflare` REQUIRES membership in `tls`: the real-IP snippet is pulled in
# from nginx_extra_http_options, which is defined in group_vars/tls/vars and gated on
# `'cloudflare' in group_names`. Every webserver should already be in `tls`, so in practice
# this is automatic -- but a cloudflare-only host would silently never include the snippet.

# Expected etag of Cloudflare's published IP list (api.cloudflare.com/client/v4/ips).
# cloudflare_ips_check.py compares the live etag against this and alerts on drift. When it
# changes, refresh this value, cloudflare_ip_ranges below, and the ranges in
# files/nginx/cloudflare/snippets/cloudflare_realip.conf together.
cloudflare_ips_expected_etag: "38f79d050aa027e3be3865e495dcc9bc"

# Cloudflare edge ranges, shared by consumers that need them as data (e.g. the origin
# firewall). Kept in sync with cloudflare_realip.conf per the etag note above.
cloudflare_ip_ranges:
  - 173.245.48.0/20
  - 103.21.244.0/22
  - 103.22.200.0/22
  - 103.31.4.0/22
  - 141.101.64.0/18
  - 108.162.192.0/18
  - 190.93.240.0/20
  - 188.114.96.0/20
  - 197.234.240.0/22
  - 198.41.128.0/17
  - 162.158.0.0/15
  - 104.16.0.0/13
  - 104.24.0.0/14
  - 172.64.0.0/13
  - 131.0.72.0/22
  - 2400:cb00::/32
  - 2606:4700::/32
  - 2803:f800::/32
  - 2405:b500::/32
  - 2405:8100::/32
  - 2a06:98c0::/29
  - 2c0f:f248::/32

# Opt-in per host: when true, ufw restricts inbound 80/443 to cloudflare_ip_ranges. Left
# false here so the group never assumes it; set true in a host's vars to enforce.
restrict_http_to_cloudflare: false
